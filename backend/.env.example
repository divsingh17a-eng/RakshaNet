# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:4000

# --- PostgreSQL + PostGIS (Neon.tech or Supabase) ---
# Single primary database for the whole product: users, reports, habitations,
# risk scores, safe sites, relocation plans/allocations, routes, response
# tasks, alerts, audit logs.
DATABASE_URL=postgresql://user:password@host:5432/rakshanet?sslmode=require

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP / SMS / IVR (optional - feature-flagged) ---
# If left blank, OTP falls back to a logged dev code and the SMS/IVR adapter
# is disabled (still demoable, clearly labeled as demo data).
OTP_PROVIDER=twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_SMS_FROM_NUMBER=
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_SUBDOMAIN=
# Required header (X-Webhook-Secret) on POST /api/sms-ivr/inbound - the gateway
# webhook has no JWT, so this is what stops anyone else from POSTing fake
# reports to it. Defaults to a dev-only value if unset; still change it.
SMS_IVR_WEBHOOK_SECRET=change-this-to-a-long-random-string

# --- Push notifications (optional) ---
FIREBASE_CONFIG=

# --- Media storage (optional - falls back to inline placeholder if unset) ---
MEDIA_STORAGE_PROVIDER=cloudinary
MEDIA_STORAGE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# --- Maps / Geocoding ---
MAPS_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
