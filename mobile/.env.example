# RakshaNet mobile app environment variables.
# Copy this file to `.env` and fill in real values for local development.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to app JS code -
# never put secrets here, this ends up bundled into the client.

# Base URL of the RakshaNet backend API (see /backend, default local port 4000).
# Use your machine's LAN IP (not "localhost") when testing on a physical
# device with Expo Go, e.g. http://192.168.1.23:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional: override the Socket.io URL if it differs from the API base URL.
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
