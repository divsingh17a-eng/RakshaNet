# RakshaNet Command Center (web) - environment variables.
# Copy to .env and fill in for your environment. Never commit .env.

# Base URL of the RakshaNet backend API (Node/Express). The app appends /api
# and derives the Socket.io URL from this same origin.
VITE_API_BASE_URL=http://localhost:4000

# Maps/geocoding provider key. Leaflet (react-leaflet) works with the free
# OpenStreetMap tile layer without a key; set this only if you wire up a
# Google Maps JS layer or a geocoding lookup.
VITE_MAPS_API_KEY=
